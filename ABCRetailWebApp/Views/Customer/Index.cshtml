@model List<ABCRetailWebApp.Models.CustomerEntity>
@{
    ViewData["Title"] = "Customers";
}

<div class="hero-section text-center mb-4">
    <h1 class="display-4">Customer Management</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0" style="color: var(--primary-green); font-weight: 600;">
        <i class="bi bi-people-fill me-2"></i>Customer List
    </h2>
    <a asp-action="Create" class="btn btn-success btn-lg shadow-sm">
        <i class="bi bi-plus-circle me-2"></i>Add New Customer
    </a>
</div>

<div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead style="background: linear-gradient(135deg, var(--primary-green) 0%, var(--light-green) 100%); color: white;">
                        <tr>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-hash me-1"></i>Customer ID
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-person me-1"></i>Name
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-envelope me-1"></i>Email
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-telephone me-1"></i>Phone
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-geo-alt me-1"></i>Address
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-calendar me-1"></i>Date Created
                            </th>
                            <th scope="col" class="px-4 py-3 text-center">
                                <i class="bi bi-gear me-1"></i>Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr class="border-bottom" style="border-color: rgba(76, 175, 80, 0.1) !important;">
                                <td class="px-4 py-3">
                                    <span class="badge bg-light text-dark border">@customer.RowKey</span>
                                </td>
                                <td class="px-4 py-3">
                                    <strong style="color: var(--dark-text);">@customer.Name</strong>
                                </td>
                                <td class="px-4 py-3">
                                    <a href="mailto:@customer.Email" class="text-decoration-none" style="color: var(--primary-green);">
                                        @customer.Email
                                    </a>
                                </td>
                                <td class="px-4 py-3">
                                    <a href="tel:@customer.Phone" class="text-decoration-none" style="color: var(--primary-green);">
                                        @customer.Phone
                                    </a>
                                </td>
                                <td class="px-4 py-3">
                                    <span style="color: var(--dark-text); opacity: 0.8;">
                                        @(customer.Address?.Length > 30 ? customer.Address.Substring(0, 30) + "..." : customer.Address)
                                    </span>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="text-muted">@customer.CreatedDate.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-rowKey="@customer.RowKey"
                                           class="btn btn-outline-success btn-sm" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-rowKey="@customer.RowKey"
                                           class="btn btn-outline-warning btn-sm" title="Edit Customer">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" method="post" style="display:inline-block"
                                              onsubmit="return confirm('Are you sure you want to delete this customer? This action cannot be undone.');">
                                            <input type="hidden" name="rowKey" value="@customer.RowKey" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Customer">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="mb-4">
                    <i class="bi bi-people" style="font-size: 4rem; color: var(--accent-green); opacity: 0.5;"></i>
                </div>
                <h4 style="color: var(--dark-text); opacity: 0.7;">No customers found</h4>
                <p class="text-muted mb-4">Get started by adding your first customer to the system.</p>
                <a asp-action="Create" class="btn btn-success btn-lg">
                    <i class="bi bi-plus-circle me-2"></i>Add Your First Customer
                </a>
            </div>
        }
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="mt-4 text-center">
        <p class="text-muted">
            <i class="bi bi-info-circle me-1"></i>
            Showing @Model.Count customer@(Model.Count == 1 ? "" : "s")
        </p>
    </div>
}