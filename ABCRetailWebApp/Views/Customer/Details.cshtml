@model ABCRetailWebApp.Models.CustomerEntity
@{
    ViewData["Title"] = "Customer Details";
}

<div class="hero-section text-center mb-4">
    <h1 class="display-4">Customer Profile</h1>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 page-title">
        <i class="bi bi-person-fill me-2"></i>Customer Details
    </h2>
    <div class="action-buttons">
        <a asp-action="Edit" asp-route-rowKey="@Model.RowKey" class="btn btn-warning">
            <i class="bi bi-pencil-square me-2"></i>Edit Customer
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">
            <i class="bi bi-arrow-left me-2"></i>Back to Customers
        </a>
    </div>
</div>

<div class="row">
    <!-- Main Customer Information Card -->
    <div class="col-lg-8">
        <div class="card info-card">
            <div class="card-header info-header">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="ms-3">
                            <h3 class="mb-1 text-white">@Model.Name</h3>
                            <small style="opacity: 0.75; color: white;">Customer ID: @Model.RowKey</small>
                        </div>
                    </div>
                    <div class="text-end">
                        <span class="badge" style="background-color: #f8f9fa; color: var(--primary-green); padding: 0.5rem 0.75rem; border-radius: 6px;">
                            <i class="bi bi-calendar me-1"></i>
                            Member since @Model.CreatedDate.ToString("MMM yyyy")
                        </span>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-borderless mb-0 details-table">
                        <tbody>
                            <tr>
                                <td class="detail-label"><i class="bi bi-hash me-2"></i>Customer ID</td>
                                <td class="px-4 py-4">
                                    <span class="badge id-badge">@Model.RowKey</span>
                                </td>
                            </tr>

                            <tr>
                                <td class="detail-label"><i class="bi bi-person me-2"></i>Full Name</td>
                                <td class="px-4 py-4"><strong>@Model.Name</strong></td>
                            </tr>

                            <tr>
                                <td class="detail-label"><i class="bi bi-envelope me-2"></i>Email Address</td>
                                <td class="px-4 py-4">
                                    @if (!string.IsNullOrEmpty(Model.Email))
                                    {
                                        <a href="mailto:@Model.Email">@Model.Email</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </td>
                            </tr>

                            <tr>
                                <td class="detail-label"><i class="bi bi-telephone me-2"></i>Phone Number</td>
                                <td class="px-4 py-4">
                                    @if (!string.IsNullOrEmpty(Model.Phone))
                                    {
                                        <a href="tel:@Model.Phone">@Model.Phone</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </td>
                            </tr>

                            <tr>
                                <td class="detail-label"><i class="bi bi-geo-alt me-2"></i>Address</td>
                                <td class="px-4 py-4">
                                    @if (!string.IsNullOrEmpty(Model.Address))
                                    {
                                        @Html.Raw(Model.Address.Replace("\n", "<br/>"))
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </td>
                            </tr>

                            <tr>
                                <td class="detail-label"><i class="bi bi-calendar-plus me-2"></i>Account Created</td>
                                <td class="px-4 py-4">
                                    <strong>@Model.CreatedDate.ToString("MMMM dd, yyyy")</strong>
                                    <br />
                                    <small class="text-muted">@Model.CreatedDate.ToString("h:mm tt")</small>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Panel -->
    <div class="col-lg-4">
        <div class="card" style="border-radius: var(--border-radius-lg);">
            <div class="card-header" style="background-color: var(--light-bg); border-radius: var(--border-radius-lg) var(--border-radius-lg) 0 0; text-align: center; color: var(--primary-green);">
                <h5 class="mb-0"><i class="bi bi-gear-fill me-2"></i>Quick Actions</h5>
            </div>
            <div class="card-body p-3">
                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-rowKey="@Model.RowKey" class="btn btn-warning btn-lg">
                        <i class="bi bi-pencil-square me-2"></i>Edit Customer
                    </a>

                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-arrow-left me-2"></i>Back to Customers
                    </a>

                    <hr style="margin: 1rem 0; border-color: var(--border-color);">

                    <button class="btn btn-outline-success btn-lg" onclick="window.print()">
                        <i class="bi bi-printer me-2"></i>Print Profile
                    </button>

                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <a href="mailto:@Model.Email" class="btn btn-outline-primary btn-lg">
                            <i class="bi bi-envelope me-2"></i>Send Email
                        </a>
                    }

                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <a href="tel:@Model.Phone" class="btn btn-outline-info btn-lg">
                            <i class="bi bi-telephone me-2"></i>Call Customer
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="card mt-3" style="border-radius: var(--border-radius-lg);">
            <div class="card-header" style="background-color: var(--light-bg); border-radius: var(--border-radius-lg) var(--border-radius-lg) 0 0; text-align: center; color: var(--primary-green);">
                <h5 class="mb-0"><i class="bi bi-graph-up me-2"></i>Customer Summary</h5>
            </div>
            <div class="card-body text-center">
                <div class="row text-center">
                    <div class="col-6">
                        <div>
                            <div class="customer-stat-value">@((DateTime.Now - Model.CreatedDate).Days)</div>
                            <small class="text-muted">Days Active</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div>
                            <div class="customer-stat-value">Active</div>
                            <small class="text-muted">Status</small>
                        </div>
                    </div>
                </div>
                <hr style="border-color: var(--border-color);" />
                <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Customer profile is complete and verified</small>
            </div>
        </div>
    </div>
</div>

<!-- Timeline Card -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card" style="border-radius: var(--border-radius-lg);">
            <div class="card-header" style="background-color: var(--light-bg); border-radius: var(--border-radius-lg) var(--border-radius-lg) 0 0; color: var(--primary-green);">
                <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Account Timeline</h5>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="avatar" style="background-color: var(--accent-green);"><i class="bi bi-person-plus-fill text-white"></i></div>
                    <div class="ms-3">
                        <strong>Customer Account Created</strong>
                        <br />
                        <small class="text-muted">@Model.CreatedDate.ToString("MMMM dd, yyyy 'at' h:mm tt")</small>
                    </div>
                </div>

                @if (Model.Timestamp.HasValue && Model.Timestamp.Value != default)
                {
                    <div class="d-flex align-items-center">
                        <div class="avatar" style="background-color: var(--primary-green);"><i class="bi bi-pencil-fill text-white"></i></div>
                        <div class="ms-3">
                            <strong>Last Profile Update</strong>
                            <br />
                            <small class="text-muted">@Model.Timestamp.Value.ToString("MMMM dd, yyyy 'at' h:mm tt")</small>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
