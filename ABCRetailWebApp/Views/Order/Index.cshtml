@model List<ABCRetailWebApp.Models.OrderEntity>
@{
    ViewData["Title"] = "Orders";
}

<div class="hero-section text-center mb-4">
    <h1 class="display-4">Order Management</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 page-title">
        <i class="bi bi-cart-check-fill me-2"></i>Orders List
    </h2>
    <a asp-action="Create" class="btn btn-success btn-lg shadow-sm">
        <i class="bi bi-plus-circle me-2"></i>Create Order
    </a>
</div>

<div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead style="background: linear-gradient(135deg, var(--primary-green) 0%, var(--light-green) 100%); color: white;">
                        <tr>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-hash me-1"></i>Order ID
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-person me-1"></i>Customer
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-box me-1"></i>Product
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-123 me-1"></i>Qty
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-currency-dollar me-1"></i>Unit Price
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-calculator me-1"></i>Total
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-flag me-1"></i>Status
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-calendar me-1"></i>Date
                            </th>
                            <th scope="col" class="px-4 py-3 text-center">
                                <i class="bi bi-gear me-1"></i>Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr style="border-bottom: 1px solid rgba(76, 175, 80, 0.1);">
                                <td class="px-4 py-3">
                                    <span class="badge id-badge">@order.RowKey.Substring(0, Math.Min(8, order.RowKey.Length))</span>
                                </td>
                                <td class="px-4 py-3">
                                    <strong style="color: var(--dark-text); font-weight: 600;">@order.CustomerName</strong>
                                </td>
                                <td class="px-4 py-3">
                                    <span style="color: var(--dark-text);">@order.ProductName</span>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="badge" style="background-color: rgba(76, 175, 80, 0.1); color: var(--primary-green); border: 1px solid rgba(76, 175, 80, 0.2);">@order.Quantity</span>
                                </td>
                                <td class="px-4 py-3">
                                    <span style="color: var(--primary-green); font-weight: 600;">@($"R{order.UnitPrice:F2}")</span>
                                </td>
                                <td class="px-4 py-3">
                                    <strong style="color: var(--primary-green); font-weight: 700; font-size: 1.1rem;">@($"R{order.TotalAmount:F2}")</strong>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="badge @(order.Status switch
                                          {
                                              "Pending" => "status-pending",
                                              "Processing" => "status-processing",
                                              "Shipped" => "status-shipped",
                                              "Delivered" => "status-delivered",
                                              "Cancelled" => "status-cancelled",
                                              _ => "badge"
                                          })">
                                @order.Status
                            </span>
                        </td>
                        <td class="px-4 py-3">
                            <span class="text-muted">@order.OrderDate.ToString("MMM dd, yyyy")</span>
                            <br />
                            <small class="text-muted">@order.OrderDate.ToString("HH:mm")</small>
                        </td>
                        <td class="px-4 py-3">
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-rowKey="@order.RowKey"
                                   class="btn btn-outline-success btn-sm" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-rowKey="@order.RowKey"
                                   class="btn btn-outline-warning btn-sm" title="Edit Order">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" method="post" style="display:inline;"
                                      onsubmit="return confirm('Are you sure you want to delete this order? This action cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rowKey" value="@order.RowKey" />
                                    <input type="hidden" name="eTag" value="@order.ETag" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Order">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 empty-state">
                <div class="mb-4">
                    <i class="bi bi-cart-x empty-icon"></i>
                </div>
                <h4 class="empty-title">No orders found</h4>
                <p class="text-muted mb-4">Start processing orders by creating your first order.</p>
                <a asp-action="Create" class="btn btn-success btn-lg">
                    <i class="bi bi-plus-circle me-2"></i>Create First Order
                </a>
            </div>
        }
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="mt-4 text-center">
        <p class="text-muted">
            <i class="bi bi-info-circle me-1"></i>
            Showing @Model.Count order@(Model.Count == 1 ? "" : "s") |
            Total Value: @($"R{Model.Sum(o => o.TotalAmount):F2}")
        </p>
    </div>
}