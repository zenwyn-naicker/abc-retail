@model List<ABCRetailWebApp.Models.OrderEntity>
@{
    ViewData["Title"] = "Customer Orders";
}

<div class="hero-section text-center mb-4">
    <h1 class="display-4">Customer Orders</h1>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 page-title">
        <i class="bi bi-person-check me-2"></i>Orders for @ViewBag.CustomerName
    </h2>
    <div class="action-buttons">
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-2"></i>New Order for Customer
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">
            <i class="bi bi-arrow-left me-2"></i>All Orders
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Customer Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0" style="border-radius: 15px; transition: all 0.3s ease;"
             onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 25px rgba(0, 0, 0, 0.12)'"
             onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0, 0, 0, 0.08)'">
            <div class="card-body text-center">
                <div style="font-size: 2rem; color: var(--primary-green); margin-bottom: 0.5rem;">
                    <i class="bi bi-cart-check-fill"></i>
                </div>
                <h3 style="font-size: 2rem; font-weight: bold; color: var(--primary-green); margin: 0.5rem 0;">@(Model?.Count ?? 0)</h3>
                <p style="margin: 0; color: var(--dark-text); font-weight: 500;">Total Orders</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0" style="border-radius: 15px; transition: all 0.3s ease;"
             onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 25px rgba(0, 0, 0, 0.12)'"
             onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0, 0, 0, 0.08)'">
            <div class="card-body text-center">
                <div style="font-size: 2rem; color: #28a745; margin-bottom: 0.5rem;">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <h3 style="font-size: 2rem; font-weight: bold; color: #28a745; margin: 0.5rem 0;">@($"R{Model?.Sum(o => o.TotalAmount) ?? 0:F2}")</h3>
                <p style="margin: 0; color: var(--dark-text); font-weight: 500;">Total Spent</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0" style="border-radius: 15px; transition: all 0.3s ease;"
             onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 25px rgba(0, 0, 0, 0.12)'"
             onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0, 0, 0, 0.08)'">
            <div class="card-body text-center">
                <div style="font-size: 2rem; color: #ffc107; margin-bottom: 0.5rem;">
                    <i class="bi bi-clock-fill"></i>
                </div>
                <h3 style="font-size: 2rem; font-weight: bold; color: #ffc107; margin: 0.5rem 0;">@(Model?.Count(o => o.Status == "Pending") ?? 0)</h3>
                <p style="margin: 0; color: var(--dark-text); font-weight: 500;">Pending Orders</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0" style="border-radius: 15px; transition: all 0.3s ease;"
             onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 25px rgba(0, 0, 0, 0.12)'"
             onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0, 0, 0, 0.08)'">
            <div class="card-body text-center">
                <div style="font-size: 2rem; color: #17a2b8; margin-bottom: 0.5rem;">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h3 style="font-size: 2rem; font-weight: bold; color: #17a2b8; margin: 0.5rem 0;">@(Model?.Count(o => o.Status == "Delivered") ?? 0)</h3>
                <p style="margin: 0; color: var(--dark-text); font-weight: 500;">Delivered Orders</p>
            </div>
        </div>
    </div>
</div>

<!-- Orders Table -->
<div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead style="background: linear-gradient(135deg, var(--primary-green) 0%, var(--light-green) 100%); color: white;">
                        <tr>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-hash me-1"></i>Order ID
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-box me-1"></i>Product
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-123 me-1"></i>Quantity
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-currency-dollar me-1"></i>Unit Price
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-calculator me-1"></i>Total Amount
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-flag me-1"></i>Status
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-calendar me-1"></i>Order Date
                            </th>
                            <th scope="col" class="px-4 py-3 text-center">
                                <i class="bi bi-gear me-1"></i>Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr style="border-bottom: 1px solid rgba(76, 175, 80, 0.1);">
                                <td class="px-4 py-3">
                                    <span class="badge id-badge">@order.RowKey.Substring(0, Math.Min(8, order.RowKey.Length))</span>
                                </td>
                                <td class="px-4 py-3">
                                    <strong style="color: var(--dark-text); font-weight: 600;">@order.ProductName</strong>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="badge" style="background-color: rgba(76, 175, 80, 0.1); color: var(--primary-green); border: 1px solid rgba(76, 175, 80, 0.2);">@order.Quantity</span>
                                </td>
                                <td class="px-4 py-3">
                                    <span style="color: var(--primary-green); font-weight: 600;">@($"R{order.UnitPrice:F2}")</span>
                                </td>
                                <td class="px-4 py-3">
                                    <strong style="color: var(--primary-green); font-weight: 700; font-size: 1.1rem;">@($"R{order.TotalAmount:F2}")</strong>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="badge @(order.Status switch
                                          {
                                              "Pending" => "status-pending",
                                              "Processing" => "status-processing",
                                              "Shipped" => "status-shipped",
                                              "Delivered" => "status-delivered",
                                              "Cancelled" => "status-cancelled",
                                              _ => "badge"
                                          })">@order.Status</span>
                        </td>
                        <td class="px-4 py-3">
                            <span class="text-muted">@order.OrderDate.ToString("MMM dd, yyyy")</span>
                        </td>
                        <td class="px-4 py-3">
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-rowKey="@order.RowKey"
                                   class="btn btn-outline-success btn-sm" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-rowKey="@order.RowKey"
                                   class="btn btn-outline-warning btn-sm" title="Edit Order">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" method="post" style="display:inline-block"
                                      onsubmit="return confirm('Are you sure you want to delete this order?');">
                                    <input type="hidden" name="rowKey" value="@order.RowKey" />
                                    <input type="hidden" name="eTag" value="@order.ETag.ToString()" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Order">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 empty-state">
                <div class="mb-4">
                    <i class="bi bi-cart-x empty-icon"></i>
                </div>
                <h4 class="empty-title">No orders found for this customer</h4>
                <p class="text-muted mb-4">This customer hasn't placed any orders yet. Start by creating their first order.</p>
                <a asp-action="Create" class="btn btn-success btn-lg">
                    <i class="bi bi-plus-circle me-2"></i>Create First Order
                </a>
            </div>
        }
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm border-0" style="border-radius: 15px;">
                <div class="card-header" style="background-color: var(--light-bg); border-radius: 15px 15px 0 0; padding: 0.75rem 1rem; text-align: center; color: var(--primary-green);">
                    <h6 class="mb-0">
                        <i class="bi bi-pie-chart me-2"></i>Order Status Breakdown
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-2">
                            <div style="padding: 1rem 0.5rem;">
                                <div class="badge status-pending" style="font-size: 1.25rem; padding: 0.5rem 1rem; margin-bottom: 0.5rem;">@Model.Count(o => o.Status == "Pending")</div>
                                <div style="font-size: 0.875rem; color: var(--dark-text); font-weight: 500;">Pending</div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div style="padding: 1rem 0.5rem;">
                                <div class="badge status-processing" style="font-size: 1.25rem; padding: 0.5rem 1rem; margin-bottom: 0.5rem;">@Model.Count(o => o.Status == "Processing")</div>
                                <div style="font-size: 0.875rem; color: var(--dark-text); font-weight: 500;">Processing</div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div style="padding: 1rem 0.5rem;">
                                <div class="badge status-shipped" style="font-size: 1.25rem; padding: 0.5rem 1rem; margin-bottom: 0.5rem;">@Model.Count(o => o.Status == "Shipped")</div>
                                <div style="font-size: 0.875rem; color: var(--dark-text); font-weight: 500;">Shipped</div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div style="padding: 1rem 0.5rem;">
                                <div class="badge status-delivered" style="font-size: 1.25rem; padding: 0.5rem 1rem; margin-bottom: 0.5rem;">@Model.Count(o => o.Status == "Delivered")</div>
                                <div style="font-size: 0.875rem; color: var(--dark-text); font-weight: 500;">Delivered</div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div style="padding: 1rem 0.5rem;">
                                <div class="badge status-cancelled" style="font-size: 1.25rem; padding: 0.5rem 1rem; margin-bottom: 0.5rem;">@Model.Count(o => o.Status == "Cancelled")</div>
                                <div style="font-size: 0.875rem; color: var(--dark-text); font-weight: 500;">Cancelled</div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div style="padding: 1rem 0.5rem;">
                                <div class="badge" style="background-color: rgba(108, 117, 125, 0.1); color: #495057; border: 1px solid rgba(108, 117, 125, 0.2); font-size: 1.25rem; padding: 0.5rem 1rem; margin-bottom: 0.5rem;">@Model.Count</div>
                                <div style="font-size: 0.875rem; color: var(--dark-text); font-weight: 500;">Total</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0" style="border-radius: 15px;">
                <div class="card-header" style="background-color: var(--light-bg); border-radius: 15px 15px 0 0; padding: 0.75rem 1rem; text-align: center; color: var(--primary-green);">
                    <h6 class="mb-0">
                        <i class="bi bi-lightbulb me-2"></i>Customer Insights
                    </h6>
                </div>
                <div class="card-body">
                    <div style="padding: 0.5rem 0; color: var(--dark-text); display: flex; align-items: center;">
                        <i class="bi bi-trophy text-warning me-2"></i>
                        <span>Average Order Value: @($"R{(Model.Any() ? Model.Average(o => o.TotalAmount) : 0):F2}")</span>
                    </div>
                    <div style="padding: 0.5rem 0; color: var(--dark-text); display: flex; align-items: center;">
                        <i class="bi bi-calendar-week text-info me-2"></i>
                        <span>First Order: @(Model.Any() ? Model.Min(o => o.OrderDate).ToString("MMM dd, yyyy") : "N/A")</span>
                    </div>
                    <div style="padding: 0.5rem 0; color: var(--dark-text); display: flex; align-items: center;">
                        <i class="bi bi-clock text-primary me-2"></i>
                        <span>Last Order: @(Model.Any() ? Model.Max(o => o.OrderDate).ToString("MMM dd, yyyy") : "N/A")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0" style="border-radius: 15px;">
                <div class="card-header" style="background-color: var(--light-bg); border-radius: 15px 15px 0 0; padding: 0.75rem 1rem; text-align: center; color: var(--primary-green);">
                    <h6 class="mb-0">
                        <i class="bi bi-gear-fill me-2"></i>Quick Actions
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Create" class="btn btn-success">
                            <i class="bi bi-plus-circle me-2"></i>Create New Order
                        </a>
                        <a asp-controller="Customer" asp-action="Details" asp-route-rowKey="@ViewBag.CustomerRowKey"
                           class="btn btn-outline-info">
                            <i class="bi bi-person me-2"></i>View Customer Profile
                        </a>
                        <button class="btn btn-outline-primary" onclick="printCustomerOrders()">
                            <i class="bi bi-printer me-2"></i>Print Order History
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function printCustomerOrders() {
        window.print();
    }
</script>