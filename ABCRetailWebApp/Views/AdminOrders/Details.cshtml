@model ABCRetailWebApp.Models.CustomerOrderEntity

@{
    ViewData["Title"] = $"Order #{Model.OrderId} - Admin";
}

<div class="container py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 mb-2" style="color: var(--primary-green);">
                <i class="bi bi-shield-check me-2"></i>Order Management
            </h1>
            <p class="text-muted mb-0">
                <span class="id-badge me-2">#@Model.OrderId</span>
                <i class="bi bi-calendar3 me-1"></i>
                @Model.OrderDate.ToString("MMMM dd, yyyy 'at' hh:mm tt")
            </p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-success">
                <i class="bi bi-arrow-left me-1"></i>Back to Orders
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(TempData["Success"] as string))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(TempData["Error"] as string))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Order Details -->
        <div class="col-lg-8 mb-4">
            <!-- Order Items Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header" style="background: var(--gradient-primary); color: white; border-radius: 8px 8px 0 0;">
                    <h5 class="mb-0">
                        <i class="bi bi-box-seam me-2"></i>Order Items
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 10%;">Item ID</th>
                                    <th style="width: 40%;">Product</th>
                                    <th class="text-center" style="width: 15%;">Quantity</th>
                                    <th class="text-end" style="width: 17%;">Unit Price</th>
                                    <th class="text-end" style="width: 18%;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="align-middle">
                                            <small class="id-badge">#@item.OrderItemId</small>
                                        </td>
                                        <td class="align-middle">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-box text-muted me-2" style="font-size: 1.5rem;"></i>
                                                <div>
                                                    <strong class="d-block">@item.ProductName</strong>
                                                    <small class="text-muted">SKU: @item.ProductRowKey</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span class="badge bg-light text-dark px-3 py-2">@item.Quantity</span>
                                        </td>
                                        <td class="text-end align-middle">
                                            <span style="color: var(--primary-green);">R @item.UnitPrice.ToString("N2")</span>
                                        </td>
                                        <td class="text-end align-middle">
                                            <strong>R @item.TotalPrice.ToString("N2")</strong>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="4" class="text-end"><strong>Order Total:</strong></td>
                                    <td class="text-end">
                                        <h5 class="mb-0" style="color: var(--primary-green);">R @Model.TotalAmount.ToString("N2")</h5>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Customer & Delivery Information Card -->
            <div class="card border-0 shadow-sm">
                <div class="card-header" style="background: var(--gradient-primary); color: white; border-radius: 8px 8px 0 0;">
                    <h5 class="mb-0">
                        <i class="bi bi-person-circle me-2"></i>Customer & Delivery Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small d-block mb-1">
                                <i class="bi bi-person me-1"></i>Customer Name
                            </label>
                            <strong class="d-block mb-3">@Model.CustomerName</strong>

                            <label class="text-muted small d-block mb-1">
                                <i class="bi bi-hash me-1"></i>User ID
                            </label>
                            <span class="id-badge">@Model.UserId</span>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small d-block mb-1">
                                <i class="bi bi-calendar-check me-1"></i>Order Date
                            </label>
                            <strong class="d-block">@Model.OrderDate.ToString("MMM dd, yyyy 'at' hh:mm tt")</strong>
                        </div>
                    </div>

                    <hr />

                    @if (!string.IsNullOrEmpty(Model.DeliveryAddress))
                    {
                        <div class="mb-3">
                            <label class="text-muted small d-block mb-2">
                                <i class="bi bi-geo-alt me-1"></i>Delivery Address
                            </label>
                            <div class="p-3 rounded" style="background: linear-gradient(135deg, rgba(76, 175, 80, 0.05) 0%, rgba(45, 125, 50, 0.05) 100%); border-left: 4px solid var(--primary-green);">
                                <i class="bi bi-truck me-2" style="color: var(--primary-green);"></i>
                                @Model.DeliveryAddress
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div>
                            <label class="text-muted small d-block mb-2">
                                <i class="bi bi-chat-left-text me-1"></i>Customer Notes
                            </label>
                            <div class="p-3 bg-light rounded">
                                <i class="bi bi-quote" style="color: var(--primary-green);"></i>
                                <em>@Model.Notes</em>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Order Actions Sidebar -->
        <div class="col-lg-4">
            <!-- Current Status Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header" style="background: var(--gradient-primary); color: white; border-radius: 8px 8px 0 0;">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>Current Status
                    </h5>
                </div>
                <div class="card-body text-center py-4">
                    @{
                        var statusClass = Model.OrderStatus.ToLower() switch
                        {
                            "pending" => "status-pending",
                            "processing" => "status-processing",
                            "processed" => "status-delivered",
                            "shipped" => "status-shipped",
                            "delivered" => "status-delivered",
                            "cancelled" => "status-cancelled",
                            _ => "badge-secondary"
                        };

                        var statusIcon = Model.OrderStatus.ToLower() switch
                        {
                            "pending" => "bi-clock-history",
                            "processing" => "bi-arrow-repeat",
                            "processed" => "bi-check-circle-fill",
                            "shipped" => "bi-truck",
                            "delivered" => "bi-check-circle-fill",
                            "cancelled" => "bi-x-circle",
                            _ => "bi-circle"
                        };
                    }

                    <i class="bi @statusIcon mb-3" style="font-size: 3.5rem; color: var(--primary-green);"></i>
                    <h3 class="mb-0">
                        <span class="badge @statusClass" style="font-size: 1.1rem;">
                            @Model.OrderStatus
                        </span>
                    </h3>
                </div>
            </div>

            <!-- Update Status Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header" style="background: var(--gradient-primary); color: white; border-radius: 8px 8px 0 0;">
                    <h5 class="mb-0">
                        <i class="bi bi-arrow-repeat me-2"></i>Update Status
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.OrderId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-list-check me-1"></i>Select New Status
                            </label>
                            <select name="newStatus" class="form-select form-select-lg" required>
                                <option value="">-- Choose Status --</option>
                                <option value="Pending" selected="@(Model.OrderStatus == "Pending")">Pending</option>
                                <option value="Processing" selected="@(Model.OrderStatus == "Processing")">Processing</option>
                                <option value="PROCESSED" selected="@(Model.OrderStatus == "PROCESSED")">PROCESSED</option>
                                <option value="Shipped" selected="@(Model.OrderStatus == "Shipped")">Shipped</option>
                                <option value="Delivered" selected="@(Model.OrderStatus == "Delivered")">Delivered</option>
                                <option value="Cancelled" selected="@(Model.OrderStatus == "Cancelled")">Cancelled</option>
                            </select>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle me-2"></i>Update Status
                            </button>
                        </div>
                    </form>

                    <!-- Quick Action -->
                    @if (Model.OrderStatus.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                    {
                        <hr class="my-3" />
                        <form asp-action="MarkAsProcessed" asp-route-orderId="@Model.OrderId" method="post">
                            @Html.AntiForgeryToken()
                            <div class="d-grid">
                                <button type="submit" class="btn btn-outline-success">
                                    <i class="bi bi-lightning-charge me-2"></i>Quick: Mark as PROCESSED
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>

            <!-- Order Summary Card -->
            <div class="card border-0 shadow-sm">
                <div class="card-header" style="background: var(--gradient-primary); color: white; border-radius: 8px 8px 0 0;">
                    <h5 class="mb-0">
                        <i class="bi bi-receipt me-2"></i>Order Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Order ID:</span>
                        <span class="id-badge">#@Model.OrderId</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Items:</span>
                        <strong>@Model.Items.Count</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">User ID:</span>
                        <span class="id-badge">@Model.UserId</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Subtotal:</span>
                        <strong>R @Model.TotalAmount.ToString("N2")</strong>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0" style="color: var(--primary-green);">Total:</h5>
                        <h4 class="mb-0" style="color: var(--primary-green);">R @Model.TotalAmount.ToString("N2")</h4>
                    </div>
                </div>
            </div>

            <!-- Admin Actions Card -->
            <div class="card border-0 shadow-sm mt-4" style="background: linear-gradient(135deg, rgba(255, 193, 7, 0.1) 0%, rgba(255, 193, 7, 0.1) 100%);">
                <div class="card-body text-center py-4">
                    <i class="bi bi-tools mb-3" style="font-size: 2.5rem; color: #856404;"></i>
                    <h6 style="color: #856404;">Admin Tools</h6>
                    <p class="text-muted small mb-3">
                        Additional order management options
                    </p>
                    <div class="d-grid gap-2">
                        <button class="btn btn-outline-warning btn-sm" disabled>
                            <i class="bi bi-printer me-1"></i>Print Invoice
                        </button>
                        <button class="btn btn-outline-warning btn-sm" disabled>
                            <i class="bi bi-envelope me-1"></i>Email Customer
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Confirm status change
        document.querySelector('form[asp-action="UpdateStatus"]')?.addEventListener('submit', function(e) {
            const select = this.querySelector('select[name="newStatus"]');
            if (select.value === '@Model.OrderStatus') {
                e.preventDefault();
                alert('Status is already set to ' + select.value);
                return false;
            }

            if (!confirm('Are you sure you want to change the order status to "' + select.value + '"?')) {
                e.preventDefault();
                return false;
            }
        });
    </script>
}
