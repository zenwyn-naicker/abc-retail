@model List<ABCRetailWebApp.Models.CustomerOrderEntity>

@{
    ViewData["Title"] = "Manage Orders";
    var currentFilter = ViewBag.CurrentFilter as string;
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="hero-section mb-4">
        <h1 class="display-4">
            <i class="bi bi-clipboard-check me-2"></i>Manage Orders
        </h1>
        <p class="lead text-muted mb-0">View and process all customer orders</p>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(TempData["Success"] as string))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(TempData["Error"] as string))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Buttons -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Index" class="btn @(string.IsNullOrEmpty(currentFilter) ? "btn-success" : "btn-outline-success")">
                    <i class="bi bi-list-ul me-1"></i>All Orders
                </a>
                <a asp-action="FilterByStatus" asp-route-status="Pending" class="btn @(currentFilter == "Pending" ? "btn-success" : "btn-outline-success")">
                    <i class="bi bi-clock-history me-1"></i>Pending
                </a>
                <a asp-action="FilterByStatus" asp-route-status="Processing" class="btn @(currentFilter == "Processing" ? "btn-success" : "btn-outline-success")">
                    <i class="bi bi-arrow-repeat me-1"></i>Processing
                </a>
                <a asp-action="FilterByStatus" asp-route-status="PROCESSED" class="btn @(currentFilter == "PROCESSED" ? "btn-success" : "btn-outline-success")">
                    <i class="bi bi-check-circle me-1"></i>Processed
                </a>
                <a asp-action="FilterByStatus" asp-route-status="Shipped" class="btn @(currentFilter == "Shipped" ? "btn-success" : "btn-outline-success")">
                    <i class="bi bi-truck me-1"></i>Shipped
                </a>
                <a asp-action="FilterByStatus" asp-route-status="Delivered" class="btn @(currentFilter == "Delivered" ? "btn-success" : "btn-outline-success")">
                    <i class="bi bi-check-circle-fill me-1"></i>Delivered
                </a>
                <a asp-action="FilterByStatus" asp-route-status="Cancelled" class="btn @(currentFilter == "Cancelled" ? "btn-success" : "btn-outline-success")">
                    <i class="bi bi-x-circle me-1"></i>Cancelled
                </a>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Orders Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-header" style="background: var(--gradient-primary); color: white; border-radius: 8px 8px 0 0;">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-table me-2"></i>Orders List
                    </h5>
                    <span class="badge bg-light text-dark">@Model.Count order@(Model.Count != 1 ? "s" : "")</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 8%;">Order ID</th>
                                <th style="width: 15%;">Customer</th>
                                <th style="width: 12%;">Order Date</th>
                                <th style="width: 10%;">Items</th>
                                <th style="width: 12%;">Total</th>
                                <th style="width: 12%;">Status</th>
                                <th style="width: 18%;">Delivery Address</th>
                                <th style="width: 13%;" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td class="align-middle">
                                        <span class="id-badge">#@order.OrderId</span>
                                    </td>
                                    <td class="align-middle">
                                        <strong>@order.CustomerName</strong>
                                    </td>
                                    <td class="align-middle">
                                        <small>
                                            @order.OrderDate.ToString("MMM dd, yyyy")
                                            <br />
                                            <span class="text-muted">@order.OrderDate.ToString("hh:mm tt")</span>
                                        </small>
                                    </td>
                                    <td class="align-middle text-center">
                                        <span class="badge bg-light text-dark">@order.Items.Count</span>
                                    </td>
                                    <td class="align-middle">
                                        <strong style="color: var(--primary-green);">R @order.TotalAmount.ToString("N2")</strong>
                                    </td>
                                    <td class="align-middle">
                                        @{
                                            var statusClass = order.OrderStatus.ToLower() switch
                                            {
                                                "pending" => "status-pending",
                                                "processing" => "status-processing",
                                                "processed" => "status-delivered",
                                                "shipped" => "status-shipped",
                                                "delivered" => "status-delivered",
                                                "cancelled" => "status-cancelled",
                                                _ => "badge-secondary"
                                            };
                                        }
                                        <span class="badge @statusClass">
                                            @order.OrderStatus
                                        </span>
                                    </td>
                                    <td class="align-middle">
                                        <small class="text-muted">
                                            @if (!string.IsNullOrEmpty(order.DeliveryAddress))
                                            {
                                                var address = order.DeliveryAddress.Length > 50
                                                ? order.DeliveryAddress.Substring(0, 50) + "..."
                                                : order.DeliveryAddress;
                                                <span>@address</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">No address</span>
                                            }
                                        </small>
                                    </td>
                                    <td class="align-middle text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-orderId="@order.OrderId"
                                               class="btn btn-outline-success" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (order.OrderStatus.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <form asp-action="MarkAsProcessed" asp-route-orderId="@order.OrderId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-success" title="Mark as Processed">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row mt-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center" style="background: linear-gradient(135deg, rgba(76, 175, 80, 0.1) 0%, rgba(45, 125, 50, 0.1) 100%);">
                    <div class="card-body py-4">
                        <i class="bi bi-receipt" style="font-size: 2.5rem; color: var(--primary-green);"></i>
                        <h3 class="mt-2 mb-0" style="color: var(--primary-green);">@Model.Count</h3>
                        <p class="text-muted mb-0 small">Total Orders</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center" style="background: linear-gradient(135deg, rgba(255, 193, 7, 0.1) 0%, rgba(255, 193, 7, 0.1) 100%);">
                    <div class="card-body py-4">
                        <i class="bi bi-clock-history" style="font-size: 2.5rem; color: #ffc107;"></i>
                        <h3 class="mt-2 mb-0" style="color: #856404;">@Model.Count(o => o.OrderStatus.Equals("Pending", StringComparison.OrdinalIgnoreCase))</h3>
                        <p class="text-muted mb-0 small">Pending</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center" style="background: linear-gradient(135deg, rgba(25, 135, 84, 0.1) 0%, rgba(25, 135, 84, 0.1) 100%);">
                    <div class="card-body py-4">
                        <i class="bi bi-check-circle-fill" style="font-size: 2.5rem; color: #198754;"></i>
                        <h3 class="mt-2 mb-0" style="color: #0a3622;">@Model.Count(o => o.OrderStatus.Equals("PROCESSED", StringComparison.OrdinalIgnoreCase))</h3>
                        <p class="text-muted mb-0 small">Processed</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm text-center" style="background: linear-gradient(135deg, rgba(13, 110, 253, 0.1) 0%, rgba(13, 110, 253, 0.1) 100%);">
                    <div class="card-body py-4">
                        <i class="bi bi-currency-dollar" style="font-size: 2.5rem; color: #0d6efd;"></i>
                        <h3 class="mt-2 mb-0" style="color: #084298;">R @Model.Sum(o => o.TotalAmount).ToString("N2")</h3>
                        <p class="text-muted mb-0 small">Total Revenue</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm text-center py-5">
                    <div class="card-body">
                        <div class="empty-icon mb-4">
                            <i class="bi bi-inbox" style="font-size: 5rem; color: var(--accent-green); opacity: 0.4;"></i>
                        </div>
                        <h3 class="mb-3" style="color: var(--dark-text);">No Orders Found</h3>
                        <p class="text-muted mb-0">
                            @if (!string.IsNullOrEmpty(currentFilter))
                            {
                                <span>No orders found with status: <strong>@currentFilter</strong></span>
                                <br />
                                <a asp-action="Index" class="btn btn-outline-success mt-3">
                                    <i class="bi bi-arrow-left me-1"></i>View All Orders
                                </a>
                            }
                            else
                            {
                                <span>There are no orders in the system yet.</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>