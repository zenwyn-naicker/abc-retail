@model List<ABCRetailWebApp.Models.ShoppingCartEntity>

@{
    ViewData["Title"] = "Shopping Cart";
    var cartTotal = ViewBag.CartTotal ?? 0m;
    var cartCount = ViewBag.CartCount ?? 0;
}

<div class="container py-4">
    <!-- Page Header -->
    <div class="hero-section mb-4">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h1 class="display-4 mb-2">
                    <i class="bi bi-cart3 me-2"></i>Shopping Cart
                </h1>
                <p class="lead text-muted mb-0">
                    @if (cartCount > 0)
                    {
                        <span>You have <strong>@cartCount</strong> @(cartCount == 1 ? "item" : "items") in your cart</span>
                    }
                    else
                    {
                        <span>Your cart is empty</span>
                    }
                </p>
            </div>
            <div>
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-success btn-lg">
                    <i class="bi bi-shop me-2"></i>Continue Shopping
                </a>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(TempData["Success"] as string))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(TempData["Error"] as string))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row">
            <!-- Cart Items -->
            <div class="col-lg-8 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header" style="background: var(--gradient-primary); color: white; border-radius: 8px 8px 0 0;">
                        <h5 class="mb-0">
                            <i class="bi bi-bag-check me-2"></i>Cart Items
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 15%;">Image</th>
                                        <th style="width: 30%;">Product</th>
                                        <th style="width: 15%;">Price</th>
                                        <th style="width: 20%;">Quantity</th>
                                        <th style="width: 15%;">Total</th>
                                        <th style="width: 5%;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <!-- Product Image -->
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <img src="@item.ImageUrl" alt="@item.ProductName" class="img-fluid rounded" style="max-width: 80px; height: 80px; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                                        <i class="bi bi-image text-muted" style="font-size: 2rem;"></i>
                                                    </div>
                                                }
                                            </td>

                                            <!-- Product Name -->
                                            <td class="align-middle">
                                                <h6 class="mb-1">@item.ProductName</h6>
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar3 me-1"></i>Added: @item.DateAdded.ToString("MMM dd, yyyy")
                                                </small>
                                            </td>

                                            <!-- Unit Price -->
                                            <td class="align-middle">
                                                <strong style="color: var(--primary-green);">R @item.UnitPrice.ToString("N2")</strong>
                                            </td>

                                            <!-- Quantity Update Form -->
                                            <td class="align-middle">
                                                <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="cartId" value="@item.CartId" />
                                                    <div class="input-group" style="max-width: 140px;">
                                                        <input type="number" name="quantity" value="@item.Quantity" min="1" max="999" class="form-control form-control-sm text-center" />
                                                        <button type="submit" class="btn btn-outline-success btn-sm">
                                                            <i class="bi bi-arrow-repeat"></i>
                                                        </button>
                                                    </div>
                                                </form>
                                            </td>

                                            <!-- Total Price -->
                                            <td class="align-middle">
                                                <strong class="text-dark">R @item.TotalPrice.ToString("N2")</strong>
                                            </td>

                                            <!-- Remove Button -->
                                            <td class="align-middle">
                                                <form asp-action="RemoveItem" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="cartId" value="@item.CartId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this item from cart?');">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Clear Cart Button -->
                <div class="mt-3">
                    <form asp-action="ClearCart" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to clear your entire cart?');">
                            <i class="bi bi-trash3 me-2"></i>Clear Cart
                        </button>
                    </form>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header" style="background: var(--gradient-primary); color: white; border-radius: 8px 8px 0 0;">
                        <h5 class="mb-0">
                            <i class="bi bi-receipt me-2"></i>Order Summary
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- Cart Statistics -->
                        <div class="mb-3 pb-3 border-bottom">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Subtotal:</span>
                                <span class="fw-bold">R @cartTotal.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Items:</span>
                                <span class="fw-bold">@cartCount</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Shipping:</span>
                                <span class="text-success fw-bold">FREE</span>
                            </div>
                        </div>

                        <!-- Total -->
                        <div class="mb-4 pb-3 border-bottom">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0" style="color: var(--primary-green);">Total:</h5>
                                <h4 class="mb-0" style="color: var(--primary-green);">R @cartTotal.ToString("N2")</h4>
                            </div>
                        </div>

                        <!-- Checkout Button -->
                        <div class="d-grid gap-2">
                            <a asp-action="Checkout" class="btn btn-success btn-lg">
                                <i class="bi bi-credit-card me-2"></i>Proceed to Checkout
                            </a>
                            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-success">
                                <i class="bi bi-arrow-left me-2"></i>Continue Shopping
                            </a>
                        </div>

                        <!-- Security Badge -->
                        <div class="text-center mt-4 pt-3 border-top">
                            <small class="text-muted">
                                <i class="bi bi-shield-check me-1" style="color: var(--primary-green);"></i>
                                Secure Checkout
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty Cart State -->
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm text-center py-5">
                    <div class="card-body">
                        <div class="empty-icon mb-4">
                            <i class="bi bi-cart-x" style="font-size: 5rem; color: var(--accent-green); opacity: 0.4;"></i>
                        </div>
                        <h3 class="mb-3" style="color: var(--dark-text);">Your Cart is Empty</h3>
                        <p class="text-muted mb-4">
                            Looks like you haven't added any items to your cart yet.
                            <br />Start shopping to fill it up!
                        </p>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-success btn-lg">
                            <i class="bi bi-shop me-2"></i>Browse Products
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Auto-submit quantity update on Enter key
        document.querySelectorAll('input[name="quantity"]').forEach(input => {
            input.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    this.closest('form').submit();
                }
            });
        });
    </script>
}