@model List<string>
@{
    ViewData["Title"] = "Contracts";
}

<div class="hero-section text-center mb-4">
    <h1 class="display-4">Contract Management</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <!-- Contract List -->
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0 page-title">
                <i class="bi bi-file-earmark-text-fill me-2"></i>Contract Library
            </h2>
            <div>
                <span class="badge" style="background-color: rgba(76, 175, 80, 0.1); color: var(--primary-green); padding: 0.5rem 0.75rem; border-radius: 20px; font-weight: 600;">
                    @(Model?.Count ?? 0) Contract@(Model?.Count == 1 ? "" : "s")
                </span>
            </div>
        </div>

        <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
            <div class="card-body p-0">
                @if (Model == null || Model.Count == 0)
                {
                    <div class="text-center py-5 empty-state">
                        <div class="mb-4">
                            <i class="bi bi-file-earmark-plus empty-icon"></i>
                        </div>
                        <h4 class="empty-title">No contracts uploaded</h4>
                        <p class="text-muted mb-4">Start building your contract library by uploading your first document.</p>
                        <button class="btn btn-success btn-lg" onclick="document.getElementById('contractFile').click()">
                            <i class="bi bi-cloud-upload me-2"></i>Upload Your First Contract
                        </button>
                    </div>
                }
                else
                {
                    <div style="padding: 1rem;">
                        @foreach (var file in Model)
                        {
                            <div style="display: flex; align-items: center; justify-content: space-between; padding: 1rem; border-bottom: 1px solid rgba(76, 175, 80, 0.1); transition: all 0.2s ease;"
                                 onmouseover="this.style.backgroundColor='rgba(76, 175, 80, 0.03)'"
                                 onmouseout="this.style.backgroundColor='transparent'">
                                <div style="display: flex; align-items: center;">
                                    <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background-color: var(--light-bg); border-radius: 8px; margin-right: 1rem;">
                                        <i class="bi @(GetFileIcon(file))"></i>
                                    </div>
                                    <div>
                                        <h6 style="margin: 0; color: var(--dark-text); font-weight: 600;">@file</h6>
                                        <small style="color: #6c757d;">
                                            <i class="bi bi-calendar me-1"></i>
                                            Document • @(GetFileSize(file))
                                        </small>
                                    </div>
                                </div>
                                <div style="display: flex; gap: 0.5rem;">
                                    <a asp-action="Download" asp-route-fileName="@file"
                                       class="btn btn-outline-success btn-sm">
                                        <i class="bi bi-download me-1"></i>Download
                                    </a>
                                    <form asp-action="Delete" method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this contract? This action cannot be undone.');">
                                        <input type="hidden" name="fileName" value="@file" />
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Upload Panel -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0" style="border-radius: 15px; margin-bottom: 1.5rem;">
            <div class="card-header" style="background-color: var(--light-bg); border-radius: 15px 15px 0 0; padding: 0.75rem 1rem; color: var(--primary-green);">
                <h5 class="mb-0">
                    <i class="bi bi-cloud-upload me-2"></i>Upload Contract
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label for="contractFile" class="form-label">
                            <i class="bi bi-file-earmark-arrow-up me-2"></i>Select Contract File
                        </label>
                        <div style="position: relative;">
                            <input type="file" class="form-control form-control-lg"
                                   id="contractFile" name="contractFile"
                                   accept=".pdf,.doc,.docx,.txt,.jpg,.jpeg,.png" required
                                   style="position: relative; z-index: 2; opacity: 0;" />
                            <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; border: 2px dashed rgba(76, 175, 80, 0.3); border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem; background-color: var(--light-bg); transition: all 0.3s ease;">
                                <i class="bi bi-cloud-upload" style="font-size: 2rem; color: var(--accent-green); margin-bottom: 0.5rem;"></i>
                                <p class="mb-1">Click to select file or drag and drop</p>
                                <small class="text-muted">PDF, DOC, DOCX, TXT, JPG, PNG (Max 10MB)</small>
                            </div>
                        </div>

                        <!-- Simple file name display -->
                        <div id="selectedFileName" style="display: none; margin-top: 1rem; padding: 0.75rem; background-color: rgba(76, 175, 80, 0.1); border: 1px solid rgba(76, 175, 80, 0.3); border-radius: 8px;">
                            <div style="display: flex; align-items: center;">
                                <i class="bi bi-file-earmark-check-fill text-success me-2"></i>
                                <span id="fileNameText" style="color: var(--dark-text); font-weight: 500;"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="bi bi-cloud-upload me-2"></i>Upload Contract
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="card shadow-sm border-0 mt-3" style="border-radius: 15px;">
                <div class="card-header" style="background-color: var(--light-bg); border-radius: 15px 15px 0 0; padding: 0.75rem 1rem; color: var(--primary-green);">
                    <h6 class="mb-0">
                        <i class="bi bi-graph-up me-2"></i>Library Summary
                    </h6>
                </div>
                <div class="card-body">
                    <div style="display: flex; justify-content: space-around; text-align: center;">
                        <div style="padding: 0.5rem;">
                            <div style="color: var(--primary-green); font-size: 1.5rem; font-weight: bold;">@Model.Count</div>
                            <div style="font-size: 0.875rem; color: var(--dark-text);">Total Contracts</div>
                        </div>
                        <div style="padding: 0.5rem;">
                            <div style="color: var(--primary-green); font-size: 1.5rem; font-weight: bold;">@Model.Count(f => f.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))</div>
                            <div style="font-size: 0.875rem; color: var(--dark-text);">PDF Documents</div>
                        </div>
                        <div style="padding: 0.5rem;">
                            <div style="color: var(--primary-green); font-size: 1.5rem; font-weight: bold;">@Model.Count(f => f.EndsWith(".doc", StringComparison.OrdinalIgnoreCase) || f.EndsWith(".docx", StringComparison.OrdinalIgnoreCase))</div>
                            <div style="font-size: 0.875rem; color: var(--dark-text);">Word Documents</div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="card shadow-sm border-0 mt-3" style="border-radius: 15px;">
            <div class="card-header" style="background-color: var(--light-bg); border-radius: 15px 15px 0 0; padding: 0.75rem 1rem; color: var(--primary-green);">
                <h6 class="mb-0">
                    <i class="bi bi-info-circle me-2"></i>Upload Guidelines
                </h6>
            </div>
            <div class="card-body">
                <div>
                    <div style="padding: 0.5rem 0; display: flex; align-items: center;">
                        <i class="bi bi-check-circle text-success me-2"></i>
                        <span>Supported formats: PDF, DOC, DOCX, TXT, JPG, PNG</span>
                    </div>
                    <div style="padding: 0.5rem 0; display: flex; align-items: center;">
                        <i class="bi bi-check-circle text-success me-2"></i>
                        <span>Maximum file size: 10MB</span>
                    </div>
                    <div style="padding: 0.5rem 0; display: flex; align-items: center;">
                        <i class="bi bi-check-circle text-success me-2"></i>
                        <span>Use descriptive file names</span>
                    </div>
                    <div style="padding: 0.5rem 0; display: flex; align-items: center;">
                        <i class="bi bi-shield-check text-info me-2"></i>
                        <span>Files are stored securely</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const fileInput = document.getElementById('contractFile');
        const selectedFileName = document.getElementById('selectedFileName');
        const fileNameText = document.getElementById('fileNameText');

        fileInput.addEventListener('change', function(event) {
            const file = event.target.files[0];

            if (file) {
                // Show the selected file name
                fileNameText.textContent = file.name;
                selectedFileName.style.display = 'block';
            } else {
                // Hide the file name display if no file is selected
                selectedFileName.style.display = 'none';
            }
        });
    });
</script>

@functions {
    private string GetFileIcon(string fileName)
    {
        var extension = System.IO.Path.GetExtension(fileName).ToLower();
        return extension switch
        {
            ".pdf" => "bi-file-pdf-fill text-danger",
            ".doc" or ".docx" => "bi-file-word-fill text-primary",
            ".txt" => "bi-file-text-fill text-secondary",
            ".jpg" or ".jpeg" or ".png" => "bi-file-image-fill text-warning",
            _ => "bi-file-earmark-fill text-muted"
        };
    }

    private string GetFileSize(string fileName)
    {
        return "Unknown size";
    }
}