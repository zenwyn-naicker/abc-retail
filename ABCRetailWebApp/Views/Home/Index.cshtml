@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-section text-center">
    <h1 class="display-4">Welcome to ABC Retail</h1>
    <p class="lead">Your one-stop shop for quality products</p>
</div>

<div class="quick-access">
    <div class="row g-4">
        <div class="col-md-4 col-sm-6">
            <a asp-area="" asp-controller="Product" asp-action="Index" class="text-decoration-none">
                <div class="access-card">
                    <i class="bi bi-box-seam"></i>
                    <h5>Products</h5>
                    <p>Browse our catalog</p>
                </div>
            </a>
        </div>
        <div class="col-md-4 col-sm-6">
            <a asp-area="" asp-controller="ShoppingCart" asp-action="Index" class="text-decoration-none">
                <div class="access-card">
                    <i class="bi bi-cart-fill"></i>
                    <h5>My Cart</h5>
                    <p>View your cart</p>
                </div>
            </a>
        </div>
        <div class="col-md-4 col-sm-6">
            <a asp-area="" asp-controller="CustomerOrders" asp-action="Index" class="text-decoration-none">
                <div class="access-card">
                    <i class="bi bi-cart-check-fill"></i>
                    <h5>My Orders</h5>
                    <p>Track your orders</p>
                </div>
            </a>
        </div>
    </div>
</div>