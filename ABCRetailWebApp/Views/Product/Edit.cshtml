@model ABCRetailWebApp.Models.ProductEntity
@{
    ViewData["Title"] = "Edit Product";
}

<div class="hero-section text-center mb-4">
    <h1 class="display-4">Edit Product</h1>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <div class="card shadow-sm border-0" style="border-radius: 15px;">
            <div class="card-header text-white py-4"
                 style="background: linear-gradient(135deg, var(--primary-green) 0%, var(--light-green) 100%); border-radius: 15px 15px 0 0;">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-pencil-square" style="font-size: 2.5rem;"></i>
                        <div class="ms-3">
                            <h3 class="mb-0">Edit Product</h3>
                            <small style="opacity: 0.75; color: white;">Product ID: @Model.RowKey</small>
                        </div>
                    </div>
                    <div class="text-end">
                        <small style="opacity: 0.75; color: white;">
                            <i class="bi bi-calendar me-1"></i>
                            Created: @Model.CreatedDate.ToString("MMM dd, yyyy")
                        </small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()
                    @* Hidden fields to preserve entity state *@
                    <input type="hidden" asp-for="RowKey" />
                    <input type="hidden" asp-for="PartitionKey" />
                    <input type="hidden" asp-for="ETag" />
                    <input type="hidden" asp-for="Timestamp" />
                    <input type="hidden" asp-for="CreatedDate" />
                    <input type="hidden" asp-for="ImageUrl" />

                    <!-- Product Name -->
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label">
                            <i class="bi bi-tag me-2"></i>Product Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name" class="form-control form-control-lg"
                               placeholder="Enter product name" required />
                        <span asp-validation-for="Name" class="text-danger mt-1 d-block"></span>
                    </div>

                    <!-- Category -->
                    <div class="mb-4">
                        <label asp-for="Category" class="form-label">
                            <i class="bi bi-folder me-2"></i>Category <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Category" class="form-control form-control-lg"
                               placeholder="e.g., Electronics, Clothing, Books" required />
                        <span asp-validation-for="Category" class="text-danger mt-1 d-block"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">
                            <i class="bi bi-text-paragraph me-2"></i>Description
                        </label>
                        <textarea asp-for="Description" class="form-control form-control-lg" rows="4"
                                  placeholder="Describe your product features and benefits"></textarea>
                        <span asp-validation-for="Description" class="text-danger mt-1 d-block"></span>
                    </div>

                    <!-- Price and Stock -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label">
                                <i class="bi bi-currency-dollar me-2"></i>Price (R) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Price" type="number" step="0.01" min="0.01"
                                   class="form-control form-control-lg"
                                   placeholder="0.00" required />
                            <span asp-validation-for="Price" class="text-danger mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Stock" class="form-label">
                                <i class="bi bi-boxes me-2"></i>Stock Quantity <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Stock" type="number" min="0"
                                   class="form-control form-control-lg"
                                   placeholder="0" required />
                            <span asp-validation-for="Stock" class="text-danger mt-1 d-block"></span>
                        </div>
                    </div>

                    <!-- Current Image -->
                    <div class="mb-4">
                        <label class="form-label">
                            <i class="bi bi-image me-2"></i>Current Image
                        </label>
                        <div style="margin-bottom: 10px;">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl" alt="@Model.Name" style="max-height: 100px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);" />
                            }
                            else
                            {
                                <div style="padding: 2rem; background-color: var(--light-bg); border-radius: 8px; text-align: center; color: var(--accent-green); border: 2px dashed rgba(76, 175, 80, 0.3);">
                                    <i class="bi bi-image"></i>
                                    <span>No Image Uploaded</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Replace Image -->
                    <div class="mb-4">
                        <label for="productImage" class="form-label">
                            <i class="bi bi-cloud-upload me-2"></i>Replace Image (optional)
                        </label>
                        <input type="file" class="form-control form-control-lg"
                               name="ImageFile" id="productImage" accept="image/*" />
                        <small class="form-text text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Supported formats: JPG, PNG, GIF, WebP. Leave empty to keep current image.
                        </small>
                        <div id="imagePreview" class="mt-2"></div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2 d-md-flex justify-content-md-between mt-5">
                        <div>
                            <a asp-action="Details" asp-route-rowKey="@Model.RowKey" class="btn btn-outline-info btn-lg me-2">
                                <i class="bi bi-eye me-2"></i>View Details
                            </a>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left me-2"></i>Back to List
                            </a>
                        </div>
                        <div>
                            <button type="submit" class="btn btn-success btn-lg px-4">
                                <i class="bi bi-check-circle me-2"></i>Update Product
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Warning Section -->
        <div class="mt-4">
            <div class="alert alert-warning" style="border-radius: 10px; border: 1px solid #ffc107;">
                <h6 class="text-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>Important Notice
                </h6>
                <p class="mb-0">
                    Changes to product information will affect all existing orders and be visible to customers immediately.
                    Please ensure all information is accurate before saving.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function() {
            'use strict';
            window.addEventListener('load', function() {
                var forms = document.getElementsByClassName('needs-validation');
                var validation = Array.prototype.filter.call(forms, function(form) {
                    form.addEventListener('submit', function(event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();

        // Image preview functionality
        document.getElementById('productImage').addEventListener('change', function(e) {
            const file = e.target.files[0];
            const previewDiv = document.getElementById('imagePreview');
            previewDiv.innerHTML = '';
            if (file) {
                const reader = new FileReader();
                reader.onload = function(ev) {
                    previewDiv.innerHTML = `<small class="text-muted d-block mb-1">New image preview:</small>
                                            <img src="${ev.target.result}" class="img-thumbnail" style="max-height: 100px;">`;
                };
                reader.readAsDataURL(file);
            }
        });

        // Confirm unsaved changes
        let formChanged = false;
        document.querySelectorAll('input, textarea, select').forEach(function(input) {
            if (!input.readOnly && input.type !== 'hidden') {
                input.addEventListener('change', function() { formChanged = true; });
            }
        });
        document.querySelectorAll('a').forEach(function(link) {
            link.addEventListener('click', function(e) {
                if (formChanged && !confirm('You have unsaved changes. Are you sure you want to leave this page?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
